`html
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AquaHaven | Premium Private Pool & Lounge</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ocean: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#06b6d4',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .pool-gradient { background: linear-gradient(135deg, #075985 0%, #0284c7 50%, #06b6d4 100%); }
        .glass-nav { background: rgba(255, 255, 255, 0.88); backdrop-filter: blur(12px); }
        .mosaic-bg {
            background-color: #0284c7;
            background-image: radial-gradient(#38bdf8 1px, transparent 1px), radial-gradient(#0369a1 1px, #0284c7 1px);
            background-size: 20px 20px;
            background-position: 0 0, 10px 10px;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased selection:bg-ocean-500 selection:text-white">

    <!-- Header Navigation -->
    <header class="fixed top-0 left-0 right-0 z-50 glass-nav border-b border-slate-200/80 transition-all duration-300">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-11 h-11 rounded-2xl pool-gradient flex items-center justify-center text-white shadow-md shadow-ocean-500/20 group-hover:scale-105 transition-transform">
                    <i data-lucide="waves" class="w-6 h-6"></i>
                </div>
                <div>
                    <span class="text-xl font-extrabold text-slate-900 tracking-tight block leading-tight">AquaHaven</span>
                    <span class="text-xs font-semibold text-ocean-600 tracking-wider uppercase">Private Pool & Lounge</span>
                </div>
            </a>

            <!-- Desktop Nav -->
            <nav class="hidden md:flex items-center gap-8 font-medium text-sm text-slate-600">
                <a href="#about" class="hover:text-ocean-600 transition-colors">Overview</a>
                <a href="#amenities" class="hover:text-ocean-600 transition-colors">Amenities</a>
                <a href="#booking" class="hover:text-ocean-600 transition-colors">Book Private Slot</a>
                <a href="#pricing" class="hover:text-ocean-600 transition-colors">Packages</a>
                <a href="#rules" class="hover:text-ocean-600 transition-colors">Rules & Safety</a>
                <a href="#reviews" class="hover:text-ocean-600 transition-colors">Reviews</a>
            </nav>

            <div class="hidden md:flex items-center gap-4">
                <a href="tel:+1234567890" class="flex items-center gap-2 text-sm font-semibold text-slate-700 hover:text-ocean-600">
                    <i data-lucide="phone" class="w-4 h-4 text-ocean-600"></i>
                    <span>+1 (800) 555-SWIM</span>
                </a>
                <a href="#booking" class="bg-ocean-600 hover:bg-ocean-700 text-white font-semibold text-sm px-5 py-2.5 rounded-xl shadow-lg shadow-ocean-600/30 transition-all hover:shadow-ocean-600/50 hover:-translate-y-0.5">
                    Reserve Now
                </a>
            </div>

            <!-- Mobile menu button -->
            <button id="mobileMenuBtn" class="md:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100">
                <i data-lucide="menu" class="w-6 h-6"></i>
            </button>
        </div>

        <!-- Mobile Drawer -->
        <div id="mobileMenu" class="hidden md:hidden border-b border-slate-200 bg-white px-4 pt-2 pb-6 space-y-3">
            <a href="#about" class="block py-2 text-slate-600 font-medium">Overview</a>
            <a href="#amenities" class="block py-2 text-slate-600 font-medium">Amenities</a>
            <a href="#booking" class="block py-2 text-slate-600 font-medium">Book Private Slot</a>
            <a href="#pricing" class="block py-2 text-slate-600 font-medium">Packages</a>
            <a href="#rules" class="block py-2 text-slate-600 font-medium">Rules & Safety</a>
            <a href="#reviews" class="block py-2 text-slate-600 font-medium">Reviews</a>
            <a href="#booking" class="block w-full text-center bg-ocean-600 text-white font-semibold py-3 rounded-xl shadow-md">Reserve Slot</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="pt-28 pb-16 lg:pt-36 lg:pb-24 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid lg:grid-cols-12 gap-12 items-center">
               
                <!-- Hero Left Content -->
                <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                    <div class="inline-flex items-center gap-2 bg-ocean-50 border border-ocean-200 rounded-full px-4 py-1.5 text-xs font-bold text-ocean-700 uppercase tracking-wider">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        100% Exclusive Private Pool Hire Available
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 tracking-tight leading-tight">
                        Your Private Urban Oasis for <span class="text-transparent bg-clip-text pool-gradient">Swim & Relaxation</span>
                    </h1>

                    <p class="text-lg text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
                        Experience pure privacy in our temperature-controlled, sheltered lap pool. Designed with premium mosaic lining, crystal-clear UV filtration, and all-weather canopy cover for family fun, parties, and swim workouts.
                    </p>

                    <!-- Key highlights chips -->
                    <div class="pt-2 flex flex-wrap justify-center lg:justify-start gap-4 text-xs font-semibold text-slate-700">
                        <div class="flex items-center gap-2 bg-white px-3.5 py-2 rounded-lg border border-slate-200 shadow-sm">
                            <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i>
                            Private Keycard Access
                        </div>
                        <div class="flex items-center gap-2 bg-white px-3.5 py-2 rounded-lg border border-slate-200 shadow-sm">
                            <i data-lucide="sun-medium" class="w-4 h-4 text-amber-500"></i>
                            Sheltered All-Weather Deck
                        </div>
                        <div class="flex items-center gap-2 bg-white px-3.5 py-2 rounded-lg border border-slate-200 shadow-sm">
                            <i data-lucide="droplets" class="w-4 h-4 text-ocean-600"></i>
                            Triple-Filtered Crystalline Water
                        </div>
                        <div class="flex items-center gap-2 bg-white px-3.5 py-2 rounded-lg border border-slate-200 shadow-sm">
                            <i data-lucide="sparkles" class="w-4 h-4 text-purple-600"></i>
                            Sound System & Lounge Lights
                        </div>
                    </div>

                    <!-- Call to action buttons -->
                    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                        <a href="#booking" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-ocean-600 hover:bg-ocean-700 text-white font-bold text-base px-8 py-4 rounded-xl shadow-xl shadow-ocean-600/30 transition-all hover:scale-[1.02]">
                            <i data-lucide="calendar" class="w-5 h-5"></i>
                            Check Available Slots
                        </a>
                        <a href="#gallery" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-100 text-slate-800 font-semibold text-base px-6 py-4 rounded-xl border border-slate-200 shadow-sm transition-all">
                            <i data-lucide="eye" class="w-5 h-5 text-ocean-600"></i>
                            View Pool Specs
                        </a>
                    </div>

                    <!-- Quick Stats -->
                    <div class="pt-6 border-t border-slate-200 grid grid-cols-3 gap-4 text-center lg:text-left">
                        <div>
                            <p class="text-2xl sm:text-3xl font-extrabold text-slate-900">30 Ft</p>
                            <p class="text-xs text-slate-500 font-medium">Pool Length</p>
                        </div>
                        <div>
                            <p class="text-2xl sm:text-3xl font-extrabold text-slate-900">4.5 Ft</p>
                            <p class="text-xs text-slate-500 font-medium">Safe Uniform Depth</p>
                        </div>
                        <div>
                            <p class="text-2xl sm:text-3xl font-extrabold text-slate-900">28°C</p>
                            <p class="text-xs text-slate-500 font-medium">Warm Water Temp</p>
                        </div>
                    </div>

                </div>

                <!-- Hero Right Media / Visual Card -->
                <div class="lg:col-span-5 relative">
                    <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-slate-900 group">
                        <!-- Visual Card Header -->
                        <div class="relative aspect-[4/3] bg-gradient-to-b from-ocean-700 to-slate-900 flex items-center justify-center p-6 text-white overflow-hidden">
                            <!-- Simulated Pool Mosaic Texture background -->
                            <div class="absolute inset-0 opacity-40 mosaic-bg"></div>
                           
                            <!-- Sheltered roof visual element -->
                            <div class="absolute top-0 left-0 right-0 h-10 bg-slate-800/80 backdrop-blur border-b border-slate-700/50 flex items-center px-4 justify-between">
                                <div class="flex items-center gap-2 text-xs font-semibold text-slate-300">
                                    <i data-lucide="home" class="w-3.5 h-3.5 text-ocean-500"></i>
                                    Sheltered Overhead Canopy
                                </div>
                                <span class="text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full font-bold uppercase">Ready to Use</span>
                            </div>

                            <!-- Pool Card Interactive Highlights -->
                            <div class="relative z-10 text-center space-y-3 mt-6">
                                <div class="w-16 h-16 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mx-auto flex items-center justify-center text-cyan-300 shadow-inner">
                                    <i data-lucide="waves" class="w-8 h-8 animate-pulse"></i>
                                </div>
                                <h3 class="text-xl font-bold text-white">AquaHaven Main Pool</h3>
                                <p class="text-xs text-cyan-100 max-w-xs mx-auto">Mosaic Tiled Pool Deck • Stainless Steel Safety Ladder • Ambient Overhead Lighting</p>
                                <span class="inline-block bg-white/20 backdrop-blur text-white text-xs font-bold px-3 py-1 rounded-full border border-white/30">
                                    Capacity: Up to 12 Guests
                                </span>
                            </div>

                            <!-- Water wave overlay -->
                            <div class="absolute bottom-0 left-0 right-0 h-12 bg-gradient-to-t from-ocean-900 to-transparent"></div>
                        </div>

                        <!-- Card Quick Details Footer -->
                        <div class="p-6 bg-white space-y-4">
                            <div class="flex justify-between items-center text-sm border-b border-slate-100 pb-3">
                                <span class="text-slate-500 font-medium">Sanitation Standard</span>
                                <span class="font-bold text-slate-800 flex items-center gap-1">
                                    <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-500"></i>
                                    UV Chlorine Dual Filter
                                </span>
                            </div>
                            <div class="flex justify-between items-center text-sm border-b border-slate-100 pb-3">
                                <span class="text-slate-500 font-medium">Booking Type</span>
                                <span class="font-bold text-slate-800">100% Private (No Strangers)</span>
                            </div>
                            <div class="flex justify-between items-center text-sm">
                                <span class="text-slate-500 font-medium">Starting Hire Rate</span>
                                <span class="font-extrabold text-ocean-600 text-lg">$45 / Hour</span>
                            </div>
                        </div>
                    </div>

                    <!-- Decorative floating badge -->
                    <div class="absolute -bottom-6 -left-6 bg-white rounded-2xl p-4 shadow-xl border border-slate-100 flex items-center gap-3 hidden sm:flex">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center font-bold">
                            <i data-lucide="star" class="w-5 h-5 fill-amber-400 text-amber-400"></i>
                        </div>
                        <div>
                            <p class="text-sm font-bold text-slate-900">4.98 / 5.0 Rating</p>
                            <p class="text-xs text-slate-500">Based on 140+ Private Bookings</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Interactive Slot Booking & Price Estimator -->
    <section id="booking" class="py-16 bg-slate-100/80 border-y border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
           
            <div class="text-center max-w-3xl mx-auto mb-12">
                <span class="text-ocean-600 font-extrabold text-xs uppercase tracking-widest bg-ocean-100/60 px-3 py-1 rounded-full">Instant Reservation</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3">Book Your Private Pool Session</h2>
                <p class="text-slate-600 mt-2">Select your date, duration, and preferred extra add-ons. Lock in your session instantly with zero hassle.</p>
            </div>

            <div class="bg-white rounded-3xl shadow-xl border border-slate-200 overflow-hidden grid lg:grid-cols-12">
               
                <!-- Booking Inputs (Left Column) -->
                <div class="lg:col-span-7 p-6 sm:p-8 space-y-6">
                   
                    <!-- Step 1: Date & Time -->
                    <div>
                        <label class="block text-sm font-bold text-slate-800 mb-2 flex items-center gap-2">
                            <i data-lucide="calendar-days" class="w-4 h-4 text-ocean-600"></i>
                            1. Select Date
                        </label>
                        <input type="date" id="bookingDate" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-slate-800 font-semibold focus:ring-2 focus:ring-ocean-500 focus:outline-none">
                    </div>

                    <!-- Step 2: Time Slot -->
                    <div>
                        <label class="block text-sm font-bold text-slate-800 mb-2 flex items-center gap-2">
                            <i data-lucide="clock" class="w-4 h-4 text-ocean-600"></i>
                            2. Choose Time Slot
                        </label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" id="slotContainer">
                            <button type="button" class="slot-btn border-2 border-slate-200 hover:border-ocean-500 rounded-xl p-2.5 text-center transition-all text-xs font-bold text-slate-700" data-time="09:00 AM - 11:00 AM">
                                09:00 - 11:00 AM
                                <span class="block text-[10px] font-normal text-slate-400">Morning Refresh</span>
                            </button>
                            <button type="button" class="slot-btn border-2 border-slate-200 hover:border-ocean-500 rounded-xl p-2.5 text-center transition-all text-xs font-bold text-slate-700 active-slot border-ocean-600 bg-ocean-50 text-ocean-700" data-time="12:00 PM - 03:00 PM">
                                12:00 - 03:00 PM
                                <span class="block text-[10px] font-normal text-slate-400">Afternoon Dip</span>
                            </button>
                            <button type="button" class="slot-btn border-2 border-slate-200 hover:border-ocean-500 rounded-xl p-2.5 text-center transition-all text-xs font-bold text-slate-700" data-time="04:00 PM - 07:00 PM">
                                04:00 - 07:00 PM
                                <span class="block text-[10px] font-normal text-slate-400">Sunset Chill</span>
                            </button>
                            <button type="button" class="slot-btn border-2 border-slate-200 hover:border-ocean-500 rounded-xl p-2.5 text-center transition-all text-xs font-bold text-slate-700" data-time="07:30 PM - 10:30 PM">
                                07:30 - 10:30 PM
                                <span class="block text-[10px] font-normal text-slate-400">Night Glow</span>
                            </button>
                        </div>
                    </div>

                    <!-- Step 3: Duration & Guests -->
                    <div class="grid sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-bold text-slate-800 mb-2 flex items-center gap-2">
                                <i data-lucide="timer" class="w-4 h-4 text-ocean-600"></i>
                                Duration (Hours)
                            </label>
                            <select id="durationSelect" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-slate-800 font-semibold focus:ring-2 focus:ring-ocean-500 focus:outline-none">
                                <option value="2">2 Hours ($90)</option>
                                <option value="3" selected>3 Hours ($135 - Popular)</option>
                                <option value="4">4 Hours ($180)</option>
                                <option value="6">Full Half-Day 6 Hours ($250)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-slate-800 mb-2 flex items-center gap-2">
                                <i data-lucide="users" class="w-4 h-4 text-ocean-600"></i>
                                Estimated Guests
                            </label>
                            <select id="guestSelect" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 text-slate-800 font-semibold focus:ring-2 focus:ring-ocean-500 focus:outline-none">
                                <option value="1-4">1 - 4 Guests (Included)</option>
                                <option value="5-8" selected>5 - 8 Guests (Standard)</option>
                                <option value="9-12">9 - 12 Guests (+ $20 extra cleaner fee)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Step 4: Optional Add-ons -->
                    <div>
                        <label class="block text-sm font-bold text-slate-800 mb-2 flex items-center gap-2">
                            <i data-lucide="plus-circle" class="w-4 h-4 text-ocean-600"></i>
                            Select Add-Ons
                        </label>
                        <div class="grid sm:grid-cols-2 gap-3">
                            <label class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-100 transition-colors">
                                <input type="checkbox" class="addon-checkbox w-4 h-4 text-ocean-600 rounded focus:ring-ocean-500" data-price="15" data-name="Pool Inflatables & Floats">
                                <div class="text-xs">
                                    <span class="font-bold text-slate-800 block">Pool Floats & Toys</span>
                                    <span class="text-slate-500">+$15 per session</span>
                                </div>
                            </label>

                            <label class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-100 transition-colors">
                                <input type="checkbox" class="addon-checkbox w-4 h-4 text-ocean-600 rounded focus:ring-ocean-500" data-price="25" data-name="BBQ Grill Station Setup">
                                <div class="text-xs">
                                    <span class="font-bold text-slate-800 block">BBQ Grill Setup</span>
                                    <span class="text-slate-500">+$25 per session</span>
                                </div>
                            </label>

                            <label class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-100 transition-colors">
                                <input type="checkbox" class="addon-checkbox w-4 h-4 text-ocean-600 rounded focus:ring-ocean-500" data-price="20" data-name="Bluetooth Party Speaker">
                                <div class="text-xs">
                                    <span class="font-bold text-slate-800 block">High Power Speaker</span>
                                    <span class="text-slate-500">+$20 per session</span>
                                </div>
                            </label>

                            <label class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200 cursor-pointer hover:bg-slate-100 transition-colors">
                                <input type="checkbox" class="addon-checkbox w-4 h-4 text-ocean-600 rounded focus:ring-ocean-500" data-price="10" data-name="Fresh Towel Service">
                                <div class="text-xs">
                                    <span class="font-bold text-slate-800 block">Fresh Towel Pack</span>
                                    <span class="text-slate-500">+$10 per session</span>
                                </div>
                            </label>
                        </div>
                    </div>

                </div>

                <!-- Price Calculator Summary (Right Column) -->
                <div class="lg:col-span-5 bg-slate-900 text-white p-6 sm:p-8 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-6">
                            <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                <i data-lucide="receipt" class="w-5 h-5 text-ocean-500"></i>
                                Booking Summary
                            </h3>
                            <span class="text-xs bg-ocean-500/20 text-ocean-300 px-2.5 py-1 rounded-full font-bold">100% Private Hire</span>
                        </div>

                        <div class="space-y-4 text-sm">
                            <div class="flex justify-between">
                                <span class="text-slate-400">Date:</span>
                                <span id="summaryDate" class="font-semibold text-white">Select Date</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">Time Slot:</span>
                                <span id="summaryTime" class="font-semibold text-white">12:00 PM - 03:00 PM</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">Duration:</span>
                                <span id="summaryDuration" class="font-semibold text-white">3 Hours</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">Guest Group:</span>
                                <span id="summaryGuests" class="font-semibold text-white">5 - 8 Guests</span>
                            </div>

                            <div class="border-t border-slate-800 pt-4">
                                <p class="text-xs text-slate-400 font-bold uppercase tracking-wider mb-2">Selected Extras</p>
                                <ul id="summaryAddonsList" class="text-xs space-y-1.5 text-slate-300">
                                    <li class="italic text-slate-500">No extra add-ons selected</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="pt-6 border-t border-slate-800 mt-6 space-y-4">
                        <div class="flex justify-between items-baseline">
                            <span class="text-slate-400 font-medium">Estimated Total:</span>
                            <span id="totalPriceDisplay" class="text-3xl font-extrabold text-cyan-400">$135</span>
                        </div>

                        <button id="openBookingModalBtn" class="w-full bg-ocean-500 hover:bg-ocean-600 text-white font-bold py-4 rounded-xl shadow-lg shadow-ocean-500/30 transition-all text-center flex items-center justify-center gap-2">
                            <i data-lucide="check-circle" class="w-5 h-5"></i>
                            Proceed to Reserve Slot
                        </button>

                        <p class="text-[11px] text-center text-slate-400">
                            🔒 No upfront payment required to hold date. Confirmation sent via SMS / WhatsApp.
                        </p>
                    </div>

                </div>

            </div>
        </div>
    </section>

    <!-- Amenities & Features Showcase -->
    <section id="amenities" class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-ocean-600 font-extrabold text-xs uppercase tracking-widest bg-ocean-100/60 px-3 py-1 rounded-full">Designed for Comfort</span>
                <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-3">Pool Specifications & Facilities</h2>
                <p class="text-slate-600 mt-2">Every detail crafted to offer you a private, hygienic, and relaxing experience.</p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
               
