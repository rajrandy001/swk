    <!-- JavaScript Application Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            lucide.createIcons();

            // Set default date to today
            const dateInput = document.getElementById('bookingDate');
            if (dateInput) {
                const today = new Date().toISOString().split('T')[0];
                dateInput.value = today;
                document.getElementById('summaryDate').textContent = today;
            }

            // Mobile menu toggle
            const mobileBtn = document.getElementById('mobileMenuBtn');
            const mobileMenu = document.getElementById('mobileMenu');
            mobileBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            // Slot Buttons selection
            const slotBtns = document.querySelectorAll('.slot-btn');
            let selectedSlot = "12:00 PM - 03:00 PM";

            slotBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    slotBtns.forEach(b => {
                        b.classList.remove('border-ocean-600', 'bg-ocean-50', 'text-ocean-700');
                        b.classList.add('border-slate-200');
                    });
                    btn.classList.remove('border-slate-200');
                    btn.classList.add('border-ocean-600', 'bg-ocean-50', 'text-ocean-700');
                    selectedSlot = btn.dataset.time;
                    document.getElementById('summaryTime').textContent = selectedSlot;
                });
            });

            // Price Calculator State
            const durationSelect = document.getElementById('durationSelect');
            const guestSelect = document.getElementById('guestSelect');
            const addonCheckboxes = document.querySelectorAll('.addon-checkbox');

            function updatePriceAndSummary() {
                // Base hourly rate = $45
                const hours = parseInt(durationSelect.value) || 3;
                let basePrice = hours * 45;
                if (hours === 6) basePrice = 250; // Discounted half day rate

                // Guests extra fee
                let extraGuestFee = 0;
                if (guestSelect.value === '9-12') extraGuestFee = 20;

                // Addons total
                let addonsTotal = 0;
                const activeAddonNames = [];

                addonCheckboxes.forEach(cb => {
                    if (cb.checked) {
                        const price = parseInt(cb.dataset.price) || 0;
                        addonsTotal += price;
                        activeAddonNames.push(`${cb.dataset.name} (+$${price})`);
                    }
                });

                const totalPrice = basePrice + extraGuestFee + addonsTotal;

                // Update UI elements
                document.getElementById('totalPriceDisplay').textContent = `$${totalPrice}`;
                document.getElementById('modalFinalPrice').textContent = `$${totalPrice}`;
                document.getElementById('summaryDuration').textContent = `${hours} Hours`;
                document.getElementById('summaryGuests').textContent = guestSelect.options[guestSelect.selectedIndex].text;

                // Update date
                if (dateInput.value) {
                    document.getElementById('summaryDate').textContent = dateInput.value;
                }

                // Update Addons List
                const addonsListEl = document.getElementById('summaryAddonsList');
                addonsListEl.innerHTML = '';
                if (activeAddonNames.length === 0) {
                    addonsListEl.innerHTML = '<li class="italic text-slate-500">No extra add-ons selected</li>';
                } else {
                    activeAddonNames.forEach(name => {
                        const li = document.createElement('li');
                        li.textContent = `• ${name}`;
                        addonsListEl.appendChild(li);
                    });
                }
            }

            durationSelect.addEventListener('change', updatePriceAndSummary);
            guestSelect.addEventListener('change', updatePriceAndSummary);
            dateInput.addEventListener('change', updatePriceAndSummary);
            addonCheckboxes.forEach(cb => cb.addEventListener('change', updatePriceAndSummary));

            // Initial calculation
            updatePriceAndSummary();

            // Booking Modal Handling
            const bookingModal = document.getElementById('bookingModal');
            const openBookingModalBtn = document.getElementById('openBookingModalBtn');
            const closeBookingModalBtn = document.getElementById('closeBookingModalBtn');
            const reservationForm = document.getElementById('reservationForm');

            openBookingModalBtn.addEventListener('click', () => {
                bookingModal.classList.remove('hidden');
            });

            closeBookingModalBtn.addEventListener('click', () => {
                bookingModal.classList.add('hidden');
            });

            reservationForm.addEventListener('submit', (e) => {
                e.preventDefault();
                bookingModal.classList.add('hidden');
                showToast('🎉 Booking Confirmed! Entry pass sent to your phone/email.');
                reservationForm.reset();
            });

            // Review Modal Handling
            const reviewModal = document.getElementById('reviewModal');
            const openReviewModalBtn = document.getElementById('openReviewModalBtn');
            const closeReviewModalBtn = document.getElementById('closeReviewModalBtn');
            const submitReviewForm = document.getElementById('submitReviewForm');

            openReviewModalBtn.addEventListener('click', () => {
                reviewModal.classList.remove('hidden');
            });

            closeReviewModalBtn.addEventListener('click', () => {
                reviewModal.classList.add('hidden');
            });

            submitReviewForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const name = document.getElementById('revName').value;
                const comment = document.getElementById('revComment').value;

                // Add card to grid
                const grid = document.getElementById('reviewsGrid');
                const card = document.createElement('div');
                card.className = "bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4";
                card.innerHTML = `
                    <div class="flex items-center gap-1 text-amber-400">
                        <i data-lucide="star" class="w-4 h-4 fill-amber-400"></i>
                        <i data-lucide="star" class="w-4 h-4 fill-amber-400"></i>
                        <i data-lucide="star" class="w-4 h-4 fill-amber-400"></i>
                        <i data-lucide="star" class="w-4 h-4 fill-amber-400"></i>
                        <i data-lucide="star" class="w-4 h-4 fill-amber-400"></i>
                    </div>
                    <p class="text-slate-600 text-sm italic">"${comment}"</p>
                    <div class="flex items-center gap-3 pt-2 border-t border-slate-100">
                        <div class="w-9 h-9 rounded-full bg-cyan-100 text-cyan-700 font-bold flex items-center justify-center text-sm">
                            ${name.substring(0,2).toUpperCase()}
                        </div>
                        <div>
                            <p class="text-sm font-bold text-slate-900">${name}</p>
                            <p class="text-[11px] text-slate-400">Verified Guest</p>
                        </div>
                    </div>
                `;
                grid.prepend(card);
                lucide.createIcons();

                reviewModal.classList.add('hidden');
                showToast('Thank you! Your review has been posted.');
                submitReviewForm.reset();
            });

            // Toast Helper
            function showToast(message) {
                const toast = document.getElementById('toastMessage');
                const toastText = document.getElementById('toastText');
                toastText.textContent = message;

                toast.classList.remove('translate-y-20', 'opacity-0');
                toast.classList.add('translate-y-0', 'opacity-100');

                setTimeout(() => {
                    toast.classList.remove('translate-y-0', 'opacity-100');
                    toast.classList.add('translate-y-20', 'opacity-0');
                }, 4000);
            }
        });
    </script>
</body>
</html>
